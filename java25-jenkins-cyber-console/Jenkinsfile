pipeline {
    agent any

    tools {
        jdk 'JDK-25'
        maven 'Maven-3.9'
    }

    environment {
        APP_NAME = 'java25-cyber-console'
        JAR_PATH = 'target/java25-cyber-console.jar'
        DEPLOY_DIR = '/opt/apps/java25-cyber-console'
        SERVER_PORT = '3000'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn clean package -DskipTests'
                archiveArtifacts artifacts: "${JAR_PATH}", fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p "${DEPLOY_DIR}"
                    cp "${JAR_PATH}" "${DEPLOY_DIR}/${APP_NAME}.jar"
                    pkill -f "${APP_NAME}.jar" || true
                    sleep 2
                    nohup java -jar "${DEPLOY_DIR}/${APP_NAME}.jar" --server.port=${SERVER_PORT} > "${DEPLOY_DIR}/console.log" 2>&1 &
                '''
            }
        }

        stage('Verify Node') {
            steps {
                sh '''
                    sleep 5
                    curl --fail http://localhost:${SERVER_PORT}/api/health
                '''
            }
        }
    }
}
